<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_fsm" model="ir.module.category">
            <field name="name">Field Service</field>
            <field name="description">Expodo Field Service permissions</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_fsm" model="res.groups.privilege">
            <field name="name">Field Service</field>
            <field name="category_id" ref="module_category_fsm"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_fsm_technician" model="res.groups">
            <field name="name">Technician</field>
            <field name="privilege_id" ref="privilege_fsm"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_fsm_planner" model="res.groups">
            <field name="name">Planner</field>
            <field name="privilege_id" ref="privilege_fsm"/>
            <field name="implied_ids" eval="[(4, ref('group_fsm_technician'))]"/>
        </record>

        <record id="group_fsm_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_fsm"/>
            <field name="implied_ids" eval="[(4, ref('group_fsm_planner'))]"/>
        </record>

        <record id="group_fsm_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_fsm"/>
            <field name="implied_ids" eval="[(4, ref('group_fsm_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="rule_fsm_order_technician_own" model="ir.rule">
            <field name="name">FSM Order: technician own</field>
            <field name="model_id" ref="model_expodo_fsm_order"/>
            <field name="groups" eval="[(4, ref('group_fsm_technician'))]"/>
            <field name="domain_force">[('technician_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_fsm_order_planner_all" model="ir.rule">
            <field name="name">FSM Order: planner all</field>
            <field name="model_id" ref="model_expodo_fsm_order"/>
            <field name="groups" eval="[(4, ref('group_fsm_planner'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_fsm_order_company" model="ir.rule">
            <field name="name">FSM Order: multi-company</field>
            <field name="model_id" ref="model_expodo_fsm_order"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_fsm_order_portal" model="ir.rule">
            <field name="name">FSM Order: portal own</field>
            <field name="model_id" ref="model_expodo_fsm_order"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
