<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_fsm" model="ir.module.category">
            <field name="name">Field Service</field>
            <field name="description">Expodo Field Service permissions</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_fsm" model="res.groups.privilege">
            <field name="name">Field Service</field>
            <field name="category_id" ref="module_category_fsm"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_fsm_technician" model="res.groups">
            <field name="name">Technician</field>
            <field name="privilege_id" ref="privilege_fsm"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_fsm_planner" model="res.groups">
            <field name="name">Planner</field>
            <field name="privilege_id" ref="privilege_fsm"/>
            <field name="implied_ids" eval="[(4, ref('group_fsm_technician'))]"/>
        </record>

        <record id="group_fsm_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_fsm"/>
            <field name="implied_ids" eval="[(4, ref('group_fsm_planner'))]"/>
        </record>

        <record id="group_fsm_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_fsm"/>
            <field name="implied_ids" eval="[(4, ref('group_fsm_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- ================= Access (Odoo 20 ir.access) ================= -->

        <!-- Intervention orders -->
        <record id="access_fsm_order_tech" model="ir.access">
            <field name="name">FSM Order: technician own</field>
            <field name="model_id" ref="model_expodo_fsm_order"/>
            <field name="group_id" ref="group_fsm_technician"/>
            <field name="operation">cru</field>
            <field name="domain">[('technician_id', '=', user.id)]</field>
        </record>

        <record id="access_fsm_order_planner" model="ir.access">
            <field name="name">FSM Order: planner all</field>
            <field name="model_id" ref="model_expodo_fsm_order"/>
            <field name="group_id" ref="group_fsm_planner"/>
            <field name="operation">cru</field>
        </record>

        <record id="access_fsm_order_manager" model="ir.access">
            <field name="name">FSM Order: manager all</field>
            <field name="model_id" ref="model_expodo_fsm_order"/>
            <field name="group_id" ref="group_fsm_manager"/>
            <field name="operation">crud</field>
        </record>

        <record id="access_fsm_order_portal" model="ir.access">
            <field name="name">FSM Order: portal own</field>
            <field name="model_id" ref="model_expodo_fsm_order"/>
            <field name="group_id" ref="base.group_portal"/>
            <field name="operation">r</field>
            <field name="domain">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        </record>

        <record id="access_fsm_order_company" model="ir.access">
            <field name="name">FSM Order: multi-company</field>
            <field name="model_id" ref="model_expodo_fsm_order"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Time lines -->
        <record id="access_fsm_time_tech" model="ir.access">
            <field name="name">FSM Time: technician</field>
            <field name="model_id" ref="model_expodo_fsm_order_line_time"/>
            <field name="group_id" ref="group_fsm_technician"/>
            <field name="operation">crud</field>
        </record>
        <record id="access_fsm_time_portal" model="ir.access">
            <field name="name">FSM Time: portal</field>
            <field name="model_id" ref="model_expodo_fsm_order_line_time"/>
            <field name="group_id" ref="base.group_portal"/>
            <field name="operation">r</field>
        </record>

        <!-- Part lines -->
        <record id="access_fsm_part_tech" model="ir.access">
            <field name="name">FSM Part: technician</field>
            <field name="model_id" ref="model_expodo_fsm_order_line_part"/>
            <field name="group_id" ref="group_fsm_technician"/>
            <field name="operation">crud</field>
        </record>
        <record id="access_fsm_part_portal" model="ir.access">
            <field name="name">FSM Part: portal</field>
            <field name="model_id" ref="model_expodo_fsm_order_line_part"/>
            <field name="group_id" ref="base.group_portal"/>
            <field name="operation">r</field>
        </record>

        <!-- Checklist tasks -->
        <record id="access_fsm_task_tech" model="ir.access">
            <field name="name">FSM Task: technician</field>
            <field name="model_id" ref="model_expodo_fsm_order_task"/>
            <field name="group_id" ref="group_fsm_technician"/>
            <field name="operation">crud</field>
        </record>
        <record id="access_fsm_task_portal" model="ir.access">
            <field name="name">FSM Task: portal</field>
            <field name="model_id" ref="model_expodo_fsm_order_task"/>
            <field name="group_id" ref="base.group_portal"/>
            <field name="operation">r</field>
        </record>

        <!-- Stages -->
        <record id="access_fsm_stage_tech" model="ir.access">
            <field name="name">FSM Stage: technician</field>
            <field name="model_id" ref="model_expodo_fsm_stage"/>
            <field name="group_id" ref="group_fsm_technician"/>
            <field name="operation">r</field>
        </record>
        <record id="access_fsm_stage_manager" model="ir.access">
            <field name="name">FSM Stage: manager</field>
            <field name="model_id" ref="model_expodo_fsm_stage"/>
            <field name="group_id" ref="group_fsm_manager"/>
            <field name="operation">crud</field>
        </record>

        <!-- Types -->
        <record id="access_fsm_type_tech" model="ir.access">
            <field name="name">FSM Type: technician</field>
            <field name="model_id" ref="model_expodo_fsm_type"/>
            <field name="group_id" ref="group_fsm_technician"/>
            <field name="operation">r</field>
        </record>
        <record id="access_fsm_type_manager" model="ir.access">
            <field name="name">FSM Type: manager</field>
            <field name="model_id" ref="model_expodo_fsm_type"/>
            <field name="group_id" ref="group_fsm_manager"/>
            <field name="operation">crud</field>
        </record>

        <!-- Type checklist templates -->
        <record id="access_fsm_type_cl_tech" model="ir.access">
            <field name="name">FSM Type Checklist: technician</field>
            <field name="model_id" ref="model_expodo_fsm_type_checklist"/>
            <field name="group_id" ref="group_fsm_technician"/>
            <field name="operation">r</field>
        </record>
        <record id="access_fsm_type_cl_manager" model="ir.access">
            <field name="name">FSM Type Checklist: manager</field>
            <field name="model_id" ref="model_expodo_fsm_type_checklist"/>
            <field name="group_id" ref="group_fsm_manager"/>
            <field name="operation">crud</field>
        </record>

    </data>
</odoo>
