<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_fsm_order" model="ir.sequence">
            <field name="name">Field Service Order</field>
            <field name="code">expodo.fsm.order</field>
            <field name="prefix">FSM/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_to_plan" model="expodo.fsm.stage">
            <field name="name">To Plan</field>
            <field name="sequence">10</field>
        </record>
        <record id="stage_planned" model="expodo.fsm.stage">
            <field name="name">Planned</field>
            <field name="sequence">20</field>
        </record>
        <record id="stage_in_progress" model="expodo.fsm.stage">
            <field name="name">In Progress</field>
            <field name="sequence">30</field>
        </record>
        <record id="stage_to_invoice" model="expodo.fsm.stage">
            <field name="name">To Invoice</field>
            <field name="sequence">40</field>
        </record>
        <record id="stage_done" model="expodo.fsm.stage">
            <field name="name">Done</field>
            <field name="sequence">50</field>
            <field name="fold" eval="True"/>
            <field name="is_closing" eval="True"/>
        </record>

    </data>
</odoo>
