<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_fsm_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Intervention <span t-field="o.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Customer:</strong>
                                <div t-field="o.partner_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Site:</strong>
                                <div t-field="o.partner_shipping_id"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-4"><strong>Type:</strong> <span t-field="o.fsm_type_id"/></div>
                            <div class="col-4"><strong>Technician:</strong> <span t-field="o.technician_id"/></div>
                            <div class="col-4"><strong>Planned:</strong> <span t-field="o.date_planned"/></div>
                        </div>

                        <h4 class="mt-4">Services</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Description</th><th class="text-end">Hours</th><th class="text-end">Unit</th><th class="text-end">Subtotal</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_time_ids" t-as="l">
                                    <td><span t-field="l.name"/></td>
                                    <td class="text-end"><span t-field="l.hours"/></td>
                                    <td class="text-end"><span t-field="l.price_unit"/></td>
                                    <td class="text-end"><span t-field="l.price_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4>Parts</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Product</th><th class="text-end">Qty</th><th class="text-end">Unit</th><th class="text-end">Subtotal</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_part_ids" t-as="p">
                                    <td><span t-field="p.product_id"/></td>
                                    <td class="text-end"><span t-field="p.quantity"/></td>
                                    <td class="text-end"><span t-field="p.price_unit"/></td>
                                    <td class="text-end"><span t-field="p.price_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr><td><strong>Total</strong></td><td class="text-end"><span t-field="o.amount_total"/></td></tr>
                                </table>
                            </div>
                        </div>

                        <t t-if="o.task_ids">
                            <h4 class="mt-3">Checklist</h4>
                            <ul>
                                <li t-foreach="o.task_ids" t-as="t">
                                    <span t-field="t.name"/>
                                    <span t-if="t.done"> (done)</span>
                                </li>
                            </ul>
                        </t>

                        <div class="row mt-5">
                            <div class="col-6">
                                <strong>Signed by:</strong> <span t-field="o.signed_by"/><br/>
                                <strong>On:</strong> <span t-field="o.signed_on"/>
                            </div>
                            <div class="col-6 text-end">
                                <img t-if="o.signature" t-att-src="image_data_uri(o.signature)"
                                     style="max-height:120px;" alt="Signature"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
